# Your Boson AI API key. Used server-side only (Authorization: Bearer).
# Copy this file to .env and fill ONE of these in. .env is gitignored.
BOSON_API_KEY=
# BOSON_API_KEY_FILE=/path/to/your/bosonapi_key

# Optional overrides
# BOSON_BASE_URL=https://api.boson.ai
# Realtime model (the code defaults to this too). `npm run probe -- connect` checks names.
BOSON_REALTIME_MODEL=higgs-realtime-1.5-preview
