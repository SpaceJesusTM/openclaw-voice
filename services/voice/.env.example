# Optional. Copy to services/voice/.env (ignored by Git). Nonempty process
# variables override this file. The Boson key already configured in
# experiments/higgs-realtime-1.5/.env is reused automatically.
BOSON_API_KEY=

# Fixed: any other model or endpoint fails at startup. No fallback.
BOSON_REALTIME_MODEL=higgs-realtime-1.5-preview
BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime?model=higgs-realtime-1.5-preview

# Optional Boson tuning; blank uses server defaults.
BOSON_VAD_THRESHOLD=
BOSON_VAD_SILENCE_MS=
BOSON_NOISE_REDUCTION=

# Agents served (defaults come from agents/team.yaml).
CLAWVOICE_AGENTS=
CLAWVOICE_DEFAULT_AGENT=
# Overrides every agent's configured Boson voice (blank = per-agent voice).
CLAWVOICE_VOICE_OVERRIDE=
# Seconds of total silence before a voice session closes (jobs continue).
CLAWVOICE_IDLE_TIMEOUT_SECS=1800
# Write sanitized session traces to ignored captures/.
CLAWVOICE_PERSIST_TRACES=true

# The OpenClaw Gateway token is NOT set here: agents/tari.yaml references
# infra/openclaw/.local/runtime.env#OPENCLAW_GATEWAY_TOKEN server-side.
