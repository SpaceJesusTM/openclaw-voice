# Optional: existing ../higgs-realtime-1.5/.env is reused automatically.
# A nonempty process variable or this directory's .env takes precedence.
BOSON_API_KEY=
BOSON_REALTIME_MODEL=higgs-realtime-1.5-preview
BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime?model=higgs-realtime-1.5-preview
BOSON_VOICE=default
BOSON_WEB_SEARCH=false

# Optional documented settings. Leave blank for Boson's defaults.
BOSON_VAD_THRESHOLD=
BOSON_VAD_SILENCE_MS=
BOSON_NOISE_REDUCTION=

# Route the demo planner through a real Pipecat bus worker (mock data only).
CLAWVOICE_MOCK_WORKER=false
