# Copy this file to .env in the same directory and add your own key.
# Never commit your real .env file.
BOSON_API_KEY=

# MUST remain the preview ID: no implicit fallback to older Higgs Realtime.
BOSON_REALTIME_MODEL=higgs-realtime-1.5-preview

# Public Boson API host for client-secret minting.
BOSON_BASE_URL=https://api.boson.ai

# Voice may be adjusted for local testing.
BOSON_VOICE=default
