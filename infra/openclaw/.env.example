# Reference ONLY. Run python3 infra/openclaw/manage.py init from the repo root.
# All live secrets are stored under ignored infra/openclaw/.local.
CLAWVOICE_NAME=Tari
CLAWVOICE_TIMEZONE=America/Toronto
CLAWVOICE_OPENCLAW_PORT=18939
# Used only when creating the initial OpenClaw configuration.
CLAWVOICE_MODEL=openai/gpt-6.1-sol
TARI_GOOGLE_ACCOUNT=
# Model auth is managed natively by OpenClaw. This demo uses ChatGPT/Codex OAuth.
# Credentials must belong to this isolated installation, never an inherited host login.
