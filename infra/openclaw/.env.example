# Reference ONLY. Run ./clawvoice-openclaw init to create .local/runtime.env.
# All live secrets are stored under ignored infra/openclaw/.local.
CLAWVOICE_NAME=Tari
CLAWVOICE_TIMEZONE=America/Toronto
CLAWVOICE_OPENCLAW_PORT=18939
CLAWVOICE_MODEL=openai/gpt-6.1-sol
TARI_GOOGLE_ACCOUNT=
TARI_CALENDAR_WRITES=0
# Preferred model auth: OpenClaw-managed ChatGPT/Codex OAuth, NOT an OpenAI API key.
# Optional API key fallback is supported but can incur separate usage charges.
OPENAI_API_KEY=
